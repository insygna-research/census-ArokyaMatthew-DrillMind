# DrillMind environment variables (copy to .env)
# All variables are optional. Defaults are safe for local development.

# How many rows of the time log to load. 0 or empty = all 419,745 rows.
DRILLMIND_MAX_ROWS=50000

# Force model retraining on next start (set to 1 only on first run).
DRILLMIND_RETRAIN=0

# Logging
DRILLMIND_LOG_LEVEL=INFO         # DEBUG / INFO / WARNING / ERROR
DRILLMIND_LOG_JSON=0             # 1 = JSON logs for ELK/Loki
# DRILLMIND_LOG_DIR=./logs       # if set, also writes rotated logs there

# LLM provider for the multi-agent assistant
# Options: fallback (rule-based, no key needed), ollama, openai, anthropic
DRILLMIND_LLM_PROVIDER=fallback
# DRILLMIND_LLM_MODEL=mistral
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
